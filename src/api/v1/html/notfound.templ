package html

import (
    "github.com/brottum-brass/forum/src/utils/language"
    "github.com/brottum-brass/forum/src/utils/theme"
)

templ NotFound(language language.Content, theme theme.Mode) {
    <div class="flex flex-col items-center justify-center h-full">
        <h1 class="text-4xl font-bold mb-4">404 - Page Not Found</h1>
        <p class="text-lg mb-6">Sorry, the page you are looking for does not exist.</p>
        <a href="/" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 transition">Go to Home</a>
    </div>
}