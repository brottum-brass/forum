package html

import (
    "github.com/brottum-brass/forum/src/utils/language"
    "github.com/brottum-brass/forum/src/utils/theme"
)

templ NotFoundView(languageContent language.Content, theme theme.Mode) {
    <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
        <div class={ "p-8 rounded-2xl border backdrop-blur-md max-w-md w-full space-y-4 shadow-lg", theme.SecondaryBackground, theme.PrimaryBorder }>
            <h1 class={ "text-3xl sm:text-4xl font-black tracking-tight", theme.PrimaryText }>
                { languageContent.NotFound.Title }
            </h1>
            <p class={ "text-xs sm:text-sm leading-relaxed", theme.SecondaryText }>
                { languageContent.NotFound.Message }
            </p>
            <div class="pt-2">
                <a 
                    href="/"
                    hx-get="/" 
                    hx-target="#main-content" 
                    hx-push-url="true"
                    class={ "inline-block px-5 py-2.5 text-xs font-bold uppercase tracking-wider rounded-xl border transition-all hover:opacity-90 active:scale-95 shadow-sm", theme.AccentBackground, theme.AccentText, theme.AccentBorder }
                >
                    { languageContent.NotFound.HomeLink }
                </a>
            </div>
        </div>
    </div>
}
