package html

import (
	"github.com/brottum-brass/forum/src/models"
	"github.com/brottum-brass/forum/src/utils/theme"
)

templ ContactInquiryForm(privacyNote string, form models.InquiryForm, theme theme.Mode) {
	<form 
		id="contact-inquiry-form"
		hx-post="/contact/inquiry" 
		hx-target="#inquiry-form-container" 
		hx-swap="outerHTML"
		class="space-y-4"
	>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div class="space-y-1.5">
				<label for="name" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
					{ form.NameLabel }
				</label>
				<input 
					type="text" 
					id="name" 
					name="name" 
					required 
					placeholder={ form.NamePlaceholder }
					class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
				/>
			</div>

			<div class="space-y-1.5">
				<label for="email" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
					{ form.EmailLabel }
				</label>
				<input 
					type="email" 
					id="email" 
					name="email" 
					required 
					placeholder={ form.EmailPlaceholder }
					class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
				/>
			</div>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div class="space-y-1.5">
				<label for="phone" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
					{ form.PhoneLabel }
				</label>
				<input 
					type="tel" 
					id="phone" 
					name="phone" 
					placeholder={ form.PhonePlaceholder }
					class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
				/>
			</div>

			<div class="space-y-1.5">
				<label for="inquiry_type" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
					{ form.TypeLabel }
				</label>
				<select 
					id="inquiry_type" 
					name="inquiry_type" 
					class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50 cursor-pointer", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
				>
					for _, opt := range form.Options {
						<option value={ opt.Key }>{ opt.Label }</option>
					}
				</select>
			</div>
		</div>

		<div class="space-y-1.5">
			<label for="message" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
				{ form.MessageLabel }
			</label>
			<textarea 
				id="message" 
				name="message" 
				rows="4" 
				required 
				placeholder={ form.MessagePlaceholder }
				class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50 resize-y", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
			></textarea>
		</div>

		<div class="space-y-2 pt-1">
			@PrivacyDisclaimer(privacyNote, theme)

			<button 
				type="submit" 
				class={ "w-full sm:w-auto px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider border transition-all hover:opacity-90 active:scale-95 shadow-sm", theme.AccentBackground, theme.AccentText, theme.AccentBorder }
			>
				{ form.SubmitButtonLabel }
			</button>
		</div>
	</form>
}

templ ContactInquirySection(privacyNote string, form models.InquiryForm, theme theme.Mode) {
	<div id="inquiry-form-container" class={ "p-6 sm:p-7 rounded-2xl border backdrop-blur-md space-y-4", theme.SecondaryBackground, theme.PrimaryBorder }>
		<div>
			<h2 class={ "text-xl font-extrabold tracking-tight", theme.PrimaryText }>
				{ form.Title }
			</h2>
			<p class={ "text-xs font-medium opacity-80 mt-0.5", theme.SecondaryText }>
				{ form.Subtitle }
			</p>
		</div>

		@ContactInquiryForm(privacyNote, form, theme)
	</div>
}

templ ContactInquirySuccess(message string, theme theme.Mode) {
	<div id="inquiry-form-container" class={ "p-8 rounded-2xl border backdrop-blur-md text-center space-y-2", theme.SecondaryBackground, theme.PrimaryBorder }>
		<div class={ "inline-flex p-3 rounded-full border mb-1", theme.AccentBackground, theme.AccentBorder }>
			<img src="/static/icons/paper-plane.svg" alt="Success" class={ "w-6 h-6 " + theme.IconFilter }/>
		</div>
		<p class={ "text-base font-bold tracking-tight", theme.PrimaryText }>
			{ message }
		</p>
	</div>
}

templ ContactInquiryError(message string, theme theme.Mode) {
	<div id="inquiry-form-container" class={ "p-8 rounded-2xl border backdrop-blur-md text-center space-y-2", theme.SecondaryBackground, theme.PrimaryBorder }>
		<p class="text-base font-bold tracking-tight text-red-500">
			{ message }
		</p>
	</div>
}
