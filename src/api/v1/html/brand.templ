package html

import (
    "github.com/brottum-brass/forum/src/utils/theme"
)

templ BrandLogo(href string, iconpath string, label string, theme theme.Mode) {
    <a 
        href={ href }
        hx-get={ href }
        hx-target="#main-content"
        hx-swap="innerHTML"
        hx-push-url="true"
        class={ "group flex items-center space-x-2 px-2 lg:px-3 py-2 rounded-lg transition-all duration-150 " + theme.HoverBackground }
    >
        <img 
            src={ iconpath } 
            alt={ label } 
            class="h-8 w-auto transition-transform duration-150 group-hover:scale-105"
        />
        <span class={ "text-xl font-bold transition-colors duration-150 " + theme.PrimaryText + " " + theme.AccentGroupHoverText }>
            { label }
        </span>
    </a>
}
