package html

import (
    "github.com/brottum-brass/forum/src/models"
	"github.com/brottum-brass/forum/src/utils/theme"
)

templ MemberApplicationForm(privacyNote string, form models.ApplicationForm, theme theme.Mode) {
	<form 
		id="member-application-form"
		hx-post="/members/apply" 
		hx-target="#application-form-container" 
		hx-swap="outerHTML"
		class="space-y-4"
	>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div class="space-y-1.5">
				<label for="name" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
					{ form.NameLabel }
				</label>
				<input 
					type="text" 
					id="name" 
					name="name" 
					required 
					placeholder={ form.NamePlaceholder }
					class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
				/>
			</div>

			<div class="space-y-1.5">
				<label for="email" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
					{ form.EmailLabel }
				</label>
				<input 
					type="email" 
					id="email" 
					name="email" 
					required 
					placeholder={ form.EmailPlaceholder }
					class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
				/>
			</div>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div class="space-y-1.5">
				<label for="phone" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
					{ form.PhoneLabel }
				</label>
				<input 
					type="tel" 
					id="phone" 
					name="phone" 
					required
					placeholder={ form.PhonePlaceholder }
					class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
				/>
			</div>

			<div class="space-y-1.5">
				<label for="birth_year" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
					{ form.BirthYearLabel }
				</label>
				<input 
					type="number" 
					id="birth_year" 
					name="birth_year" 
					placeholder={ form.BirthYearPlaceholder }
					class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
				/>
			</div>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div class="space-y-1.5">
				<label for="instrument" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
					{ form.InstrumentLabel }
				</label>
				<input 
					type="text" 
					id="instrument" 
					name="instrument" 
					required 
					placeholder={ form.InstrumentPlaceholder }
					class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
				/>
			</div>

			<div class="space-y-1.5">
				<label for="preferred_part" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
					{ form.PreferredPartLabel }
				</label>
				<input 
					type="text" 
					id="preferred_part" 
					name="preferred_part" 
					placeholder={ form.PreferredPartPlaceholder }
					class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
				/>
			</div>
		</div>

		<div class="space-y-1.5">
			<label for="experience" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
				{ form.ExperienceLabel }
			</label>
			<textarea 
				id="experience" 
				name="experience" 
				rows="3" 
				placeholder={ form.ExperiencePlaceholder }
				class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50 resize-y", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
			></textarea>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div class="space-y-1.5">
				<label for="reference_name" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
					{ form.ReferenceNameLabel }
				</label>
				<input 
					type="text" 
					id="reference_name" 
					name="reference_name" 
					placeholder={ form.ReferenceNamePlaceholder }
					class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
				/>
			</div>

			<div class="space-y-1.5">
				<label for="reference_phone" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
					{ form.ReferencePhoneLabel }
				</label>
				<input 
					type="tel" 
					id="reference_phone" 
					name="reference_phone" 
					placeholder={ form.ReferencePhonePlaceholder }
					class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
				/>
			</div>
		</div>

		<div class="space-y-1.5">
			<label for="notes" class={ "block text-xs font-bold uppercase tracking-wider", theme.PrimaryText }>
				{ form.NotesLabel }
			</label>
			<textarea 
				id="notes" 
				name="notes" 
				rows="3" 
				placeholder={ form.NotesPlaceholder }
				class={ "w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:ring-2 focus:ring-opacity-50 resize-y", theme.SecondaryBackground, theme.PrimaryBorder, theme.PrimaryText }
			></textarea>
		</div>

		<div class="space-y-2 pt-1">
			@PrivacyDisclaimer(privacyNote, theme)

			<button 
				type="submit" 
				class={ "w-full sm:w-auto px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider border transition-all hover:opacity-90 active:scale-95 shadow-sm", theme.AccentBackground, theme.AccentText, theme.AccentBorder }
			>
				{ form.SubmitButtonLabel }
			</button>
		</div>
	</form>
}

templ MemberApplicationSection(privacyNote string, form models.ApplicationForm, theme theme.Mode) {
    <div id="application-form-container" class={ "p-6 sm:p-7 rounded-2xl border backdrop-blur-md ", theme.SecondaryBackground, theme.PrimaryBorder }>
        <details class="group">
            <summary class="flex items-center justify-between cursor-pointer list-none focus:outline-none">
                <div>
                    <h2 class={ "text-xl font-extrabold tracking-tight ", theme.PrimaryText }>
                        { form.Title }
                    </h2>
                    <p class={ "text-xs font-medium opacity-80 mt-0.5 ", theme.SecondaryText }>
                        { form.Subtitle }
                    </p>
                </div>

                <div class={ "p-2 rounded-xl border shrink-0 transition-transform duration-200 group-open:rotate-180 ", theme.PrimaryBorder, theme.HoverBackground }>
                    <img src="/static/icons/chevron-down.svg" alt="Toggle Form" class={ "w-4 h-4 " + theme.IconFilter }/>
                </div>
            </summary>

            <div class="pt-6">
                @MemberApplicationForm(privacyNote, form, theme)
            </div>
        </details>
    </div>
}

templ MemberApplicationSuccess(message string, theme theme.Mode) {
	<div id="application-form-container" class={ "p-8 rounded-2xl border backdrop-blur-md text-center space-y-2", theme.SecondaryBackground, theme.PrimaryBorder }>
		<div class={ "inline-flex p-3 rounded-full border mb-1", theme.AccentBackground, theme.AccentBorder }>
			<img src="/static/icons/members.svg" alt="Success" class={ "w-6 h-6 " + theme.IconFilter }/>
		</div>
		<p class={ "text-base font-bold tracking-tight", theme.PrimaryText }>
			{ message }
		</p>
	</div>
}

templ MemberApplicationError(message string, theme theme.Mode) {
	<div id="application-form-container" class={ "p-8 rounded-2xl border backdrop-blur-md text-center space-y-2", theme.SecondaryBackground, theme.PrimaryBorder }>
		<p class="text-base font-bold tracking-tight text-red-500">
			{ message }
		</p>
	</div>
}
