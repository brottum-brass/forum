package html

import (
    "github.com/brottum-brass/forum/src/utils/language"
    "github.com/brottum-brass/forum/src/utils/theme"
)

templ Header(language language.Content, theme theme.Mode) {
    <header class={ "border-b sticky top-0 z-50 transition-colors duration-200 shadow-sm " + theme.SecondaryBackground + " " + theme.PrimaryBorder }>
        <div class="container mx-auto px-4 py-3 flex flex-row items-center justify-between">
            
            <div class="flex items-center space-x-3 shrink-0">
                @BrandLogo(language.Common.Name, theme)
            </div>

            @DesktopNav(language, theme)

            <div class={ "hidden md:flex flex-row items-center space-x-4 border-l pl-6 " + theme.PrimaryBorder }>
                @ThemeToggle(theme)
                @LanguageSelect(language, theme)
            </div>

            <div class="flex md:hidden flex-row items-center space-x-2">
                @ThemeToggle(theme)
                @HamburgerButton(theme)
            </div>
        </div>

        @MobileNav(language, theme)

        <div class={ "h-[3px] bg-gradient-to-r from-transparent to-transparent w-full absolute bottom-0 left-0 " + theme.AccentGradient }></div>
    </header>
}
