package html

import "github.com/brottum-brass/forum/src/utils/language"
import "github.com/brottum-brass/forum/src/utils/theme"

templ Document(language language.Content, theme theme.Mode, content templ.Component) {
    <!DOCTYPE html>
    <html lang={ language.Common.Language }>
        @Head(language.Common.Title)
        @Body(language, theme, content)
    </html>
}

templ Head(title string) {
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <meta name="htmx-config" content='{"globalViewTransitions": true}'/>
        <title>{ title }</title>
        <link rel="icon" href="/static/icons/logo_transparent.png" type="image/png"/>
        <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js" integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="/static/css/output.css"/>
    </head>
}

templ Body(language language.Content, theme theme.Mode, content templ.Component) {
    <body class="min-h-screen flex flex-col">
        @AppRoot(language, theme, content)
    </body>
}

templ AppRoot(language language.Content, theme theme.Mode, content templ.Component) {
    <div id="app-root" class={ "min-h-screen flex flex-col w-full transition-colors duration-200 " + theme.PrimaryBackground + " " + theme.PrimaryText }>
        @Header(language, theme)
        
        <main class="flex-grow container mx-auto px-4 py-6">
            @content
        </main>

        @Footer(language, theme)
    </div>
}

templ Header(language language.Content, theme theme.Mode) {
    <header class={ "border-b sticky top-0 z-50 transition-colors duration-200 shadow-sm " + theme.SecondaryBackground + " " + theme.PrimaryBorder }>
        <div class="container mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <a href="/" class="flex items-center space-x-2 group">
                    <img src="/static/icons/logo_transparent.png" alt="Logo" class="h-8 w-auto group-hover:scale-105 transition-transform"/>
                    <span class={ "text-xl font-bold transition group-hover:text-amber-500 " + theme.PrimaryText }>
                        { language.Common.Name }
                    </span>
                </a>
            </div>

            <div class="flex items-center space-x-8">
                <nav>
                    <ul class="flex items-center space-x-6">
                        <li>
                            <a href="/events" class={ "group flex items-center space-x-2 font-medium transition hover:text-amber-500 " + theme.SecondaryText }>
                                <img src="/static/icons/events.svg" alt="" class={ "h-5 w-5 transition group-hover:brightness-125 " + theme.IconFilter }/>
                                <span>{ language.Header.Events }</span>
                            </a>
                        </li>
                        <li>
                            <a href="/about" class={ "group flex items-center space-x-2 font-medium transition hover:text-amber-500 " + theme.SecondaryText }>
                                <img src="/static/icons/about.svg" alt="" class={ "h-5 w-5 transition group-hover:brightness-125 " + theme.IconFilter }/>
                                <span>{ language.Header.About }</span>
                            </a>
                        </li>
                        <li>
                            <a href="/members" class={ "group flex items-center space-x-2 font-medium transition hover:text-amber-500 " + theme.SecondaryText }>
                                <img src="/static/icons/members.svg" alt="" class={ "h-5 w-5 transition group-hover:brightness-125 " + theme.IconFilter }/>
                                <span>{ language.Header.Members }</span>
                            </a>
                        </li>
                        <li>
                            <a href="/contact" class={ "group flex items-center space-x-2 font-medium transition hover:text-amber-500 " + theme.SecondaryText }>
                                <img src="/static/icons/contact.svg" alt="" class={ "h-5 w-5 transition group-hover:brightness-125 " + theme.IconFilter }/>
                                <span>{ language.Header.Contact }</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>

            <div class={ "flex items-center space-x-4 border-l pl-6 " + theme.PrimaryBorder }>
                <button 
                    hx-get="/toggle-theme" 
                    hx-target="#app-root" 
                    hx-swap="outerHTML transition:true"
                    type="button" 
                    aria-label="Toggle Theme"
                    class={ "p-2 rounded-lg transition focus:outline-none hover:bg-amber-500/10 hover:text-amber-500 border border-transparent hover:border-amber-500/30 " + theme.SecondaryText }
                >
                    if theme.Name == "darkmode" {
                        <img src="/static/icons/sun.svg" alt="Light Mode" class={ "h-5 w-5 " + theme.IconFilter }/>
                    } else {
                        <img src="/static/icons/moon.svg" alt="Dark Mode" class={ "h-5 w-5 " + theme.IconFilter }/>
                    }
                </button>

                <select 
                    name="language"
                    hx-get="/change-language" 
                    hx-target="#app-root"
                    hx-swap="outerHTML transition:true"
                    hx-trigger="change"
                    class={ "text-sm rounded-lg p-2 font-medium border hover:border-amber-500 focus:ring-2 focus:ring-amber-500 focus:outline-none transition cursor-pointer " + theme.SecondaryBackground + " " + theme.PrimaryBorder + " " + theme.PrimaryText }
                >
                    <option value="en" selected?={ language.Common.Language == "en" }>EN</option>
                    <option value="no" selected?={ language.Common.Language == "no" }>NO</option>
                </select>
            </div>
        </div>

        <div class="h-[3px] bg-gradient-to-r from-transparent via-amber-500/50 to-transparent w-full absolute bottom-0 left-0"></div>
    </header>
}

templ Footer(language language.Content, theme theme.Mode) {
    <footer class={ "border-t mt-auto transition-colors duration-200 relative " + theme.SecondaryBackground + " " + theme.PrimaryBorder }>
        <div class="h-[3px] bg-gradient-to-r from-transparent via-amber-500/50 to-transparent w-full absolute top-0 left-0"></div>

        <div class="container mx-auto px-4 py-6 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-3">
                <img src="/static/icons/logo_transparent.png" alt="Logo" class="h-6 w-auto"/>
                <span class={ "font-semibold " + theme.PrimaryText }>
                    { language.Common.Name }
                </span>
            </div>

            <div class="flex items-center space-x-4">
                <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="p-1.5 rounded-md hover:bg-amber-500/10 transition group">
                    <img src="/static/icons/facebook.svg" alt="Facebook" class={ "h-5 w-5 opacity-80 group-hover:opacity-100 " + theme.IconFilter }/>
                </a>
                <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="p-1.5 rounded-md hover:bg-amber-500/10 transition group">
                    <img src="/static/icons/instagram.svg" alt="Instagram" class={ "h-5 w-5 opacity-80 group-hover:opacity-100 " + theme.IconFilter }/>
                </a>
            </div>

            <p class={ "text-sm " + theme.SecondaryText }>
                { language.Footer.Copyright }
            </p>
        </div>
    </footer>
}